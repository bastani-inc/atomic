{
	"name": "@bastani/atomic-telemetry",
	"version": "0.0.0",
	"description": "Vendor-neutral telemetry contracts and typed schema utilities for pi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./render": {
			"source": "./src/render.ts",
			"types": "./dist/render.d.ts",
			"import": "./dist/render.js"
		},
		"./testing": {
			"source": "./src/testing/index.ts",
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"telemetry",
		"tracing",
		"observability"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"contributors": [
		"Bastani, Inc."
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bastani-inc/atomic.git",
		"directory": "packages/telemetry"
	},
	"homepage": "https://github.com/bastani-inc/atomic/tree/main/packages/telemetry#readme",
	"bugs": {
		"url": "https://github.com/bastani-inc/atomic/issues"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"vitest": "4.1.12"
	}
}

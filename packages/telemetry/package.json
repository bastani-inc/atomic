{
  "name": "@bastani/atomic-telemetry",
  "version": "0.10.4-alpha.2",
  "description": "Atomic's vendor-neutral telemetry contracts, typed schemas and reference contexts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "module": "./dist/_modules/index.js",
      "browser": "./dist/_modules/index.js",
      "import": "./dist/index.js"
    },
    "./render": {
      "source": "./src/render.ts",
      "types": "./dist/render.d.ts",
      "module": "./dist/_modules/render.js",
      "browser": "./dist/_modules/render.js",
      "import": "./dist/render.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "module": "./dist/_modules/testing/index.js",
      "browser": "./dist/_modules/testing/index.js",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "clean": "node ../../scripts/package-files.mjs clean dist",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --run",
    "prepublishOnly": "npm run clean && npm run build",
    "build:bundle": "node ../../scripts/bundle-package-dist.mjs",
    "prepack": "node -e \"require('node:fs').existsSync('../../scripts/bundle-package-dist.mjs') && require('node:child_process').execSync('npm run build:bundle', { stdio: 'inherit' })\""
  },
  "keywords": [
    "telemetry",
    "tracing",
    "observability",
    "atomic"
  ],
  "author": "Mario Zechner",
  "license": "MIT",
  "contributors": [
    "Bastani, Inc."
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bastani-inc/atomic.git",
    "directory": "packages/telemetry"
  },
  "homepage": "https://docs.bastani.ai/libraries/telemetry",
  "bugs": {
    "url": "https://github.com/bastani-inc/atomic/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "vitest": "4.1.12"
  }
}

{
  "name": "@bastani/web-access",
  "version": "0.10.5-alpha.1",
  "private": true,
  "description": "Atomic extension for web search, URL fetching, GitHub repository cloning, and PDF and video extraction.",
  "contributors": [
    "Norin Lavaee",
    "Alex Lavaee"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "*.ts",
    "curator-page-assets/**/*.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@bastani/atomic": "*",
    "@bastani/atomic-ai": "*",
    "@bastani/atomic-tui": "*"
  },
  "peerDependenciesMeta": {
    "@bastani/atomic": {
      "optional": true
    },
    "@bastani/atomic-ai": {
      "optional": true
    },
    "@bastani/atomic-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.15",
    "p-limit": "^7.3.2",
    "turndown": "^7.2.5",
    "unpdf": "1.8.1"
  }
}

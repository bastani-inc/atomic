{
  "name": "@bastani/feedback",
  "version": "0.0.0",
  "private": true,
  "description": "Safe conversational feedback drafting for Atomic.",
  "contributors": [
    "Norin Lavaee",
    "Alex Lavaee"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./core": "./src/index.ts"
  },
  "files": ["*.ts", "src/**/*.ts", "skills/**/*", "README.md", "CHANGELOG.md"],
  "atomic": {
    "extensions": ["./index.ts"],
    "skills": ["./skills"]
  },
  "pi": {
    "extensions": ["./index.ts"],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@bastani/atomic": "*"
  },
  "peerDependenciesMeta": {
    "@bastani/atomic": {
      "optional": true
    }
  },
  "dependencies": {
    "typebox": "^1.3.7"
  }
}

{
  "name": "@bastani/atomic-tui",
  "version": "0.10.2",
  "description": "Atomic's terminal UI framework with differential rendering for flicker-free interactive CLIs",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node ../../scripts/package-files.mjs clean dist",
    "build": "tsc -p tsconfig.build.json",
    "build:native:darwin": "native/darwin/build.sh",
    "build:native:linux": "native/linux/build.sh",
    "build:native:win32": "node native/win32/build.mjs",
    "test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "files": [
    "dist/**/*",
    "native/napi.h",
    "native/clipboard.h",
    "native/win32/prebuilds/**/*.node",
    "native/win32/src/**/*.c",
    "native/win32/build.mjs",
    "native/win32/README.md",
    "native/darwin/prebuilds/**/*.node",
    "native/darwin/src/**/*.m",
    "native/darwin/build.sh",
    "native/darwin/README.md",
    "native/linux/prebuilds/**/*.node",
    "native/linux/src/**/*.{c,h}",
    "native/linux/build.sh",
    "native/linux/README.md",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "keywords": [
    "tui",
    "terminal",
    "ui",
    "text-editor",
    "differential-rendering",
    "typescript",
    "cli",
    "atomic"
  ],
  "author": "Mario Zechner",
  "license": "MIT",
  "contributors": [
    "Bastani, Inc."
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bastani-inc/atomic.git",
    "directory": "packages/tui"
  },
  "homepage": "https://docs.bastani.ai/libraries/tui",
  "bugs": {
    "url": "https://github.com/bastani-inc/atomic/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "get-east-asian-width": "1.7.0",
    "marked": "18.0.11",
    "marked-cjk-friendly": "0.1.3"
  },
  "devDependencies": {
    "@xterm/headless": "6.0.0",
    "chalk": "6.0.0"
  }
}

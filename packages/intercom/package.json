{
  "name": "@bastani/intercom",
  "version": "0.10.10",
  "private": true,
  "description": "Atomic extension for direct messaging and coordination between parent, child, and peer agent sessions.",
  "contributors": [
    "Norin Lavaee",
    "Alex Lavaee"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "*.ts",
    "broker/**/*.ts",
    "ui/**/*.ts",
    "skills/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "atomic": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@bastani/atomic": "*",
    "@bastani/atomic-ai": "*",
    "@bastani/atomic-tui": "*"
  },
  "peerDependenciesMeta": {
    "@bastani/atomic": {
      "optional": true
    },
    "@bastani/atomic-ai": {
      "optional": true
    },
    "@bastani/atomic-tui": {
      "optional": true
    }
  }
}

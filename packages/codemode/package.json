{
  "name": "@bastani/atomic-codemode",
  "version": "0.10.1-alpha.1",
  "description": "Atomic's sandboxed JavaScript execution where the only capability is calling injected tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./declarations": {
      "source": "./src/declarations.ts",
      "types": "./dist/declarations.d.ts",
      "import": "./dist/declarations.js"
    },
    "./source": {
      "source": "./src/source.ts",
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js"
    },
    "./portable": {
      "source": "./src/portable.ts",
      "types": "./dist/portable.d.ts",
      "import": "./dist/portable.js"
    },
    "./cloudflare": {
      "source": "./src/cloudflare.ts",
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    },
    "./worker": {
      "source": "./src/runtime/worker.ts",
      "types": "./dist/runtime/worker.d.ts",
      "import": "./dist/runtime/worker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "clean": "node ../../scripts/package-files.mjs clean dist",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "codemode",
    "sandbox",
    "quickjs",
    "wasm",
    "cloudflare",
    "durable-objects",
    "atomic"
  ],
  "author": "Earendil Works",
  "license": "MIT",
  "contributors": [
    "Bastani, Inc."
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bastani-inc/atomic.git",
    "directory": "packages/codemode"
  },
  "homepage": "https://docs.bastani.ai/libraries/codemode",
  "bugs": {
    "url": "https://github.com/bastani-inc/atomic/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "quickjs-wasi": "3.6.3"
  },
  "devDependencies": {
    "vitest": "4.1.12"
  }
}

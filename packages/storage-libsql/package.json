{
  "name": "@bastani/atomic-storage-libsql",
  "version": "0.9.55-alpha.1",
  "description": "libSQL / Turso storage adapter for Atomic sessions, workflow journals, and Intercom.",
  "contributors": [
    "Norin Lavaee",
    "Alex Lavaee"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./libsql.js",
  "types": "./libsql.d.ts",
  "exports": {
    ".": {
      "types": "./libsql.d.ts",
      "import": "./libsql.js",
      "default": "./libsql.js"
    }
  },
  "files": [
    "libsql.js",
    "libsql.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bastani-inc/atomic.git",
    "directory": "packages/storage-libsql"
  },
  "homepage": "https://github.com/bastani-inc/atomic/tree/main/packages/storage-libsql#readme",
  "bugs": {
    "url": "https://github.com/bastani-inc/atomic/issues"
  },
  "keywords": [
    "atomic",
    "storage",
    "libsql",
    "turso",
    "sqlite",
    "bastani"
  ],
  "atomic": {
    "storageAdapters": [
      "./libsql.js"
    ]
  },
  "pi": {
    "storageAdapters": [
      "./libsql.js"
    ]
  },
  "dependencies": {
    "@libsql/client": "0.18.0"
  },
  "peerDependencies": {
    "@bastani/atomic": "*"
  },
  "peerDependenciesMeta": {
    "@bastani/atomic": {
      "optional": true
    }
  }
}

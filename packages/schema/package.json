{
	"name": "@bastani/atomic-schema",
	"version": "0.0.0",
	"description": "Atomic's JSON Schema builders and validation without eval: drafts 2020-12 and 7, compiled into plain closures",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"module": "./dist/_modules/index.js",
			"browser": "./dist/_modules/index.js",
			"import": "./dist/index.js"
		},
		"./formats": {
			"source": "./src/formats/index.ts",
			"types": "./dist/formats/index.d.ts",
			"module": "./dist/_modules/formats/index.js",
			"browser": "./dist/_modules/formats/index.js",
			"import": "./dist/formats/index.js"
		},
		"./typebox": {
			"source": "./src/typebox/index.ts",
			"types": "./dist/typebox/index.d.ts",
			"bun": "./dist/typebox/package/index.js",
			"module": "./dist/_modules/typebox/index.js",
			"browser": "./dist/_modules/typebox/index.js",
			"import": "./dist/typebox/index.js"
		},
		"./typebox/compile": {
			"source": "./src/typebox/compile.ts",
			"types": "./dist/typebox/compile.d.ts",
			"bun": "./dist/typebox/package/compile.js",
			"module": "./dist/_modules/typebox/compile.js",
			"browser": "./dist/_modules/typebox/compile.js",
			"import": "./dist/typebox/compile.js"
		},
		"./typebox/error": {
			"source": "./src/typebox/error.ts",
			"types": "./dist/typebox/error.d.ts",
			"bun": "./dist/typebox/package/error.js",
			"module": "./dist/_modules/typebox/error.js",
			"browser": "./dist/_modules/typebox/error.js",
			"import": "./dist/typebox/error.js"
		},
		"./typebox/format": {
			"source": "./src/typebox/format.ts",
			"types": "./dist/typebox/format.d.ts",
			"bun": "./dist/typebox/package/format.js",
			"module": "./dist/_modules/typebox/format.js",
			"browser": "./dist/_modules/typebox/format.js",
			"import": "./dist/typebox/format.js"
		},
		"./typebox/guard": {
			"source": "./src/typebox/guard.ts",
			"types": "./dist/typebox/guard.d.ts",
			"bun": "./dist/typebox/package/guard.js",
			"module": "./dist/_modules/typebox/guard.js",
			"browser": "./dist/_modules/typebox/guard.js",
			"import": "./dist/typebox/guard.js"
		},
		"./typebox/schema": {
			"source": "./src/typebox/schema.ts",
			"types": "./dist/typebox/schema.d.ts",
			"bun": "./dist/typebox/package/schema.js",
			"module": "./dist/_modules/typebox/schema.js",
			"browser": "./dist/_modules/typebox/schema.js",
			"import": "./dist/typebox/schema.js"
		},
		"./typebox/system": {
			"source": "./src/typebox/system.ts",
			"types": "./dist/typebox/system.d.ts",
			"bun": "./dist/typebox/package/system.js",
			"module": "./dist/_modules/typebox/system.js",
			"browser": "./dist/_modules/typebox/system.js",
			"import": "./dist/typebox/system.js"
		},
		"./typebox/type": {
			"source": "./src/typebox/type.ts",
			"types": "./dist/typebox/type.d.ts",
			"bun": "./dist/typebox/package/type.js",
			"module": "./dist/_modules/typebox/type.js",
			"browser": "./dist/_modules/typebox/type.js",
			"import": "./dist/typebox/type.js"
		},
		"./typebox/value": {
			"source": "./src/typebox/value.ts",
			"types": "./dist/typebox/value.d.ts",
			"bun": "./dist/typebox/package/value.js",
			"module": "./dist/_modules/typebox/value.js",
			"browser": "./dist/_modules/typebox/value.js",
			"import": "./dist/typebox/value.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"THIRD_PARTY_NOTICES",
		"LICENSE",
		"NOTICE.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build",
		"build:bundle": "node ../../scripts/bundle-package-dist.mjs --inline=typebox --standalone=typebox/package/",
		"prepack": "node -e \"require('node:fs').existsSync('../../scripts/bundle-package-dist.mjs') && require('node:child_process').execSync('npm run build:bundle', { stdio: 'inherit' })\""
	},
	"keywords": [
		"json-schema",
		"validation",
		"validator",
		"csp",
		"atomic"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"contributors": [
		"Bastani, Inc."
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bastani-inc/atomic.git",
		"directory": "packages/schema"
	},
	"homepage": "https://docs.bastani.ai/libraries/schema",
	"bugs": {
		"url": "https://github.com/bastani-inc/atomic/issues"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"vitest": "4.1.12"
	}
}

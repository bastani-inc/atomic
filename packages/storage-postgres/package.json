{
  "name": "@bastani/atomic-storage-postgres",
  "version": "0.0.0",
  "description": "PostgreSQL storage adapter for Atomic sessions, workflow journals, and Intercom.",
  "contributors": ["Norin Lavaee", "Alex Lavaee"],
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "main": "./postgres.js",
  "types": "./postgres.d.ts",
  "exports": { ".": { "types": "./postgres.d.ts", "import": "./postgres.js", "default": "./postgres.js" } },
  "files": ["postgres.js", "postgres.d.ts", "README.md", "CHANGELOG.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bastani-inc/atomic.git",
    "directory": "packages/storage-postgres"
  },
  "homepage": "https://github.com/bastani-inc/atomic/tree/main/packages/storage-postgres#readme",
  "bugs": { "url": "https://github.com/bastani-inc/atomic/issues" },
  "keywords": ["atomic", "storage", "postgres", "postgresql", "bastani"],
  "atomic": { "storageAdapters": ["./postgres.js"] },
  "pi": { "storageAdapters": ["./postgres.js"] },
  "dependencies": { "pg": "8.23.1", "pg-connection-string": "2.14.1" },
  "peerDependencies": { "@bastani/atomic": "*" },
  "peerDependenciesMeta": { "@bastani/atomic": { "optional": true } }
}

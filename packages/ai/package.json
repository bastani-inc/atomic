{
  "name": "@bastani/pi-ai",
  "version": "0.9.86-alpha.1",
  "description": "Bastani-branded unified LLM API with automatic model discovery and provider configuration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/compat.js",
    "./dist/images.js",
    "./dist/providers/images/register-builtins.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./session-resources": {
      "types": "./dist/session-resources.d.ts",
      "import": "./dist/session-resources.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js"
    },
    "./api/*": {
      "types": "./dist/api/*.d.ts",
      "import": "./dist/api/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js"
    },
    "./bedrock-provider": {
      "types": "./dist/bedrock-provider.d.ts",
      "import": "./dist/bedrock-provider.js"
    },
    "./bun-oauth": {
      "types": "./dist/bun-oauth.d.ts",
      "import": "./dist/bun-oauth.js"
    },
    "./lazy-bedrock-provider": {
      "types": "./dist/lazy-bedrock-provider.d.ts",
      "import": "./dist/lazy-bedrock-provider.js"
    },
    "./lazy-oauth": {
      "types": "./dist/lazy-oauth.d.ts",
      "import": "./dist/lazy-oauth.js"
    }
  },
  "bin": {
    "pi-ai": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node ../../scripts/package-files.mjs clean dist",
    "generate-models": "node scripts/generate-models.ts --strict",
    "hydrate-model-data": "node scripts/generate-models.ts --strict --data-only",
    "generate-model-catalog": "node scripts/generate-models.ts --strict --json-only --json-output .artifacts/model-catalog",
    "generate-decision-models": "node scripts/generate-decision-models.ts --strict",
    "check:model-data": "node scripts/check-model-data.ts",
    "build": "npm run generate-models && npm run build:offline",
    "build:offline": "npm run check:model-data && tsc -p tsconfig.build.json && node ../../scripts/package-files.mjs clean dist/providers/data && node ../../scripts/package-files.mjs copy src/providers/data dist/providers",
    "test": "vitest --run",
    "typecheck": "node ../../scripts/bun-typecheck.mjs -p tsconfig.json",
    "check": "biome check --error-on-warnings . && npm run typecheck",
    "format": "biome check --write .",
    "prepublishOnly": "npm run clean && npm run build",
    "build:catalog": "npm run generate-models && npm run build:offline"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@aws-sdk/client-bedrock-runtime": "3.1127.0",
    "@earendil-works/pi-schema": "1.5.2",
    "@earendil-works/pi-telemetry": "1.5.2",
    "@google/genai": "2.32.0",
    "@smithy/node-http-handler": "4.13.0",
    "http-proxy-agent": "9.1.0",
    "https-proxy-agent": "9.1.0",
    "openai": "7.19.0",
    "partial-json": "0.1.7",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "canvas": "3.2.3",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "keywords": [
    "ai",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "bedrock",
    "unified",
    "api",
    "bastani"
  ],
  "author": "Mario Zechner",
  "contributors": [
    "Bastani, Inc."
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bastani-inc/atomic.git",
    "directory": "packages/ai"
  },
  "homepage": "https://github.com/bastani-inc/atomic/tree/main/packages/ai#readme",
  "bugs": {
    "url": "https://github.com/bastani-inc/atomic/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}

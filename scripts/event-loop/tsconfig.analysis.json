{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"customConditions": ["source"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["bun", "node"],
		"typeRoots": ["../../node_modules/@types"],
		"lib": ["ESNext"],
		"allowImportingTsExtensions": true,
		"allowArbitraryExtensions": true,
		"noEmit": true,
		"allowJs": false,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"paths": {
			"@bastani/atomic": ["../../packages/coding-agent/src/index.ts"],
			"@bastani/atomic/storage": ["../../packages/coding-agent/src/core/storage/index.ts"],
			"@bastani/subagents": ["../../packages/subagents/src/extension/index.ts"],
			"@bastani/subagents/*": ["../../packages/subagents/src/*"],
			"@bastani/mcp": ["../../packages/mcp/index.ts"],
			"@bastani/mcp/*": ["../../packages/mcp/*"],
			"@bastani/web-access": ["../../packages/web-access/index.ts"],
			"@bastani/web-access/*": ["../../packages/web-access/*"],
			"@bastani/intercom": ["../../packages/intercom/index.ts"],
			"@bastani/intercom/*": ["../../packages/intercom/*"],
			"@bastani/atomic-tui": ["../../packages/tui/src/index.ts"],
			"@bastani/atomic-tui/*": ["../../packages/tui/src/*"],
			"@bastani/atomic-ai": ["../../packages/ai/src/index.ts"],
			"@bastani/atomic-ai/*": ["../../packages/ai/src/*"],
			"@bastani/atomic-agent-core": ["../../packages/agent/src/index.ts"]
		}
	},
	"include": [
		"../../packages/coding-agent/src/**/*.ts",
		"../../packages/tui/src/**/*.ts",
		"../../packages/agent/src/**/*.ts",
		"../../packages/ai/src/**/*.ts",
		"../../packages/codemode/src/**/*.ts",
		"../../packages/subagents/src/**/*.ts",
		"../../packages/intercom/**/*.ts",
		"../../packages/mcp/**/*.ts",
		"../../packages/web-access/**/*.ts"
	],
	"exclude": ["../../**/node_modules", "../../**/dist", "../../**/test", "../../**/*.test.ts", "../../**/*.d.ts"]
}

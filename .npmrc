# Committed so install policy binds every contributor, not just CI. Mirrors
# upstream pi's .npmrc for `save-exact`, and replaces the `[install]` block
# bunfig.toml carried before the toolchain moved to npm.
#
# `min-release-age=0` is a deliberate divergence from upstream pi, which sets 2.
# Atomic adopts pi releases the same day they publish, and a nonzero value blocks
# that by construction: pi v0.84.2 published at 10:05Z and could not have been
# resolved until two days later. The release-age cooldown is therefore not a
# control this repository can hold. `.github/dependabot.yml` carries the matching
# `cooldown: 0` so the two sides do not drift.
#
# What this gives up: the window in which a compromised publish is normally
# detected and yanked. `npm-shrinkwrap.json` ships inside `@bastani/atomic`, so a
# bad resolve reaches users. Restore the gate by setting both values back to 2.
save-exact=true
min-release-age=0

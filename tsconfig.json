{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["bun"],
        "typeRoots": ["./node_modules/@types"],
        "lib": ["ESNext"],
        "allowImportingTsExtensions": true,
        "allowArbitraryExtensions": true,
        "noEmit": true,
        "allowJs": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "paths": {
            "@bastani/atomic": ["./packages/coding-agent/src/index.ts"],
            "@bastani/atomic/storage": ["./packages/coding-agent/src/core/storage/index.ts"],
            "@bastani/subagents": [
                "./packages/subagents/src/extension/index.ts"
            ],
            "@bastani/subagents/*": ["./packages/subagents/src/*"],
            "@bastani/mcp": ["./packages/mcp/index.ts"],
            "@bastani/mcp/*": ["./packages/mcp/*"],
            "@bastani/web-access": ["./packages/web-access/index.ts"],
            "@bastani/web-access/*": ["./packages/web-access/*"],
            "@bastani/intercom": ["./packages/intercom/index.ts"],
            "@bastani/intercom/*": ["./packages/intercom/*"]
        }
    },
    "include": [
        "packages/coding-agent/src/**/*.d.ts",
        "packages/storage-libsql/*.js",
        "packages/storage-postgres/*.js",
        "test/**/*",
        "examples/**/*",
        "scripts/release/*.ts"
    ],
    "exclude": [
        "node_modules",
        "packages/coding-agent",
        "packages/ai",
        "packages/subagents",
        "packages/mcp",
        "packages/web-access",
        "packages/intercom",
        "test/fixtures/intercom-0.9.71",
        "test/fixtures/intercom-0.9.77-alpha.1",
        "test/fixtures/snapshot-store-0.9.87",
        "test/fixtures/snapshot-store-0.9.89",
        "test/fixtures/intercom-0.9.88-pre-5067",
        "test/fixtures/intercom-pre-5218",
        "test/fixtures/intercom-socket-lock-main"
    ]
}

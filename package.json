{
  "name": "atomic-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.4.0"
  },
  "contributors": [
    "Norin Lavaee",
    "Alex Lavaee"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs && node scripts/alias-pi-ai.mjs",
    "hooks:install": "npx --no-install prek install --prepare-hooks",
    "hooks:run": "npx --no-install prek run --all-files",
    "build": "npm --workspace=@bastani/pi-ai run build && node scripts/alias-pi-ai.mjs && npm --workspace=@bastani/atomic-natives run build",
    "generate:models": "npm --workspace=@bastani/pi-ai run generate-models && npm --workspace=@bastani/pi-ai run generate-image-models",
    "hydrate:model-data": "npm --workspace=@bastani/pi-ai run hydrate-model-data",
    "test": "npm run test:scripts && vitest --run && npm --workspaces --if-present run test",
    "test:unit": "vitest --run --project unit",
    "test:integration": "vitest --run --project integration",
    "test:ci-contracts": "vitest --run --project ci",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "typecheck": "npm --workspace=@bastani/pi-ai run build && node scripts/alias-pi-ai.mjs && tsc --noEmit && npm --workspace=@bastani/atomic run typecheck",
    "format": "biome format --write .",
    "check": "biome check --error-on-warnings . && npm run typecheck && npm run check:shrinkwrap",
    "lint": "npm run check",
    "check:shrinkwrap": "node scripts/generate-coding-agent-shrinkwrap.mjs --check",
    "shrinkwrap:coding-agent": "node scripts/generate-coding-agent-shrinkwrap.mjs"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "@biomejs/biome": "2.5.8",
    "@j178/prek": "0.4.11",
    "@types/bun": "1.3.14",
    "@types/tar-stream": "3.1.4",
    "jszip": "3.10.1",
    "superjson": "1.13.3",
    "tar-stream": "3.2.0",
    "tinyglobby": "0.2.17",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@types/node": "24.12.4",
    "protobufjs": "7.6.5",
    "brace-expansion": "5.0.9",
    "typebox": "1.3.7",
    "semver": "7.8.0",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "@napi-rs/cli": {
      "semver": "7.8.5"
    }
  }
}

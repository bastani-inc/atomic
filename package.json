{
  "name": "atomic-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.4.5"
  },
  "contributors": [
    "Norin Lavaee",
    "Alex Lavaee"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "npx --no-install prek install --prepare-hooks",
    "hooks:run": "npx --no-install prek run --all-files",
    "build": "node scripts/build.mjs",
    "generate:models": "npm --workspace=@bastani/atomic-ai run generate-models && npm --workspace=@bastani/atomic-ai run generate-decision-models",
    "hydrate:model-data": "npm --workspace=@bastani/atomic-ai run hydrate-model-data",
    "test": "npm run test:scripts && vitest --run && npm --workspaces --if-present run test",
    "test:unit": "vitest --run --project unit",
    "test:integration": "vitest --run --project integration --project integration-ui-gate",
    "test:ci-contracts": "vitest --run --project ci",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:mcp-conformance": "bun run packages/coding-agent/test/mcp-conformance/run.ts",
    "typecheck": "node scripts/refresh-package-dist.mjs packages/schema packages/telemetry packages/ai && npm --workspace=@bastani/atomic-ai run typecheck && node scripts/refresh-package-dist.mjs packages/tui packages/agent packages/codemode && node scripts/bun-typecheck.mjs && npm --workspace=@bastani/atomic run typecheck",
    "format": "biome format --write .",
    "check": "biome check --error-on-warnings . && npm run typecheck && npm run check:event-loop",
    "lint": "npm run check",
    "check:event-loop": "node scripts/event-loop/check-event-loop.ts"
  },
  "devDependencies": {
    "@babel/parser": "8.1.2",
    "@babel/types": "8.1.2",
    "@biomejs/biome": "2.5.8",
    "@eslint-community/regexpp": "4.12.3",
    "@j178/prek": "0.5.11",
    "@libsql/client": "0.18.0",
    "@types/bun": "1.4.5",
    "@types/pg": "8.23.1",
    "@types/tar-stream": "3.1.5",
    "@xterm/headless": "6.0.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "esbuild": "0.28.2",
    "jszip": "3.10.2",
    "regexp-ast-analysis": "0.7.1",
    "rolldown": "1.2.15",
    "superjson": "2.2.6",
    "tar-stream": "3.3.0",
    "tinyglobby": "0.2.17",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@types/node": "24.12.4",
    "protobufjs": "7.6.6",
    "brace-expansion": "5.0.12",
    "typebox": "1.3.27",
    "semver": "7.8.5",
    "hono": "4.13.16",
    "ip-address": "10.7.4",
    "@napi-rs/cli": {
      "semver": "7.8.5",
      "@octokit/types": "18.0.0"
    },
    "@hono/node-server": "2.1.8"
  }
}
